"""Experiments for iterated, block-wise CMC.

    snakemake --use-conda --cores 4                     # everything (slow; normally on Actions)
    snakemake --use-conda --cores 1 summarise           # tables and figures from existing fits
    snakemake --cores 2 --configfile config/smoke.yaml \
        --config config_file=config/smoke.yaml results=results_smoke   # quick end-to-end check

Fits run on GitHub Actions (.github/workflows/experiments.yml): one job per
(example, method, seed), each running this Snakefile for its target; a final
job merges the fits and runs `summarise`. Every number is in config/config.yaml.
"""

configfile: "config/config.yaml"

import yaml

ENV = "envs/cmc.yaml"
CFG = config.get("config_file", "config/config.yaml")
RES = config.get("results", "results")
# read the experiment from CFG itself: --configfile merges nested keys into config.yaml,
# which would leak the main examples into a smoke run
C = yaml.safe_load(open(CFG))
EXAMPLES = list(C["examples"])
METHODS = list(C["methods"])
SEEDS = C["seeds"]
# an example may restrict its methods with `methods: [...]`
FITS = [RES + f"/fits/{e}/{m}_seed{s}.json" for e in EXAMPLES
        for m in C["examples"][e].get("methods", METHODS) for s in SEEDS]
CODE = ["cmc/models.py", "cmc/infer.py", "cmc/ratio.py", "cmc/metrics.py", "cmc/bayes.py", "cmc/ssa.py"]


rule all:
    input:
        RES + "/summary/table.md",


rule data:
    input:
        code=CODE + ["workflow/scripts/make_data.py"],
        real=lambda w: C["examples"][w.example].get("data_csv", C["examples"][w.example].get("data_tracks", [])),
    output:
        RES + "/data/{example}_seed{seed}.npz",
    params:
        cfg=CFG,
    conda:
        ENV
    shell:
        "PYTHONPATH=. python workflow/scripts/make_data.py --example {wildcards.example} "
        "--seed {wildcards.seed} --config {params.cfg} --out {output}"


# external methods (competitors) run with their own code, often in their own environment, and write
# population draws (npz) or a Gaussian population (json) that `fit` scores like every other method
EXTERNAL = {m: C["methods"][m].get("tool", "arruda") for m in C["methods"] if C["methods"][m]["kind"] == "external"}
EXT_SUFFIX = {"arruda": "npz", "sourcerer": "npz", "neb": "npz", "npmle": "npz", "pmetrics": "npz", "mlnpe": "npz", "pepsdi": "npz", "nlmixr2": "json"}
ARRUDA_REPO = config.get("arruda_repo", "external/Amortized-NLME-Models")
ARRUDA_COMMIT = "592c8912300c68ab241160eb3e739a2651209a03"
SOURCERER_REPO = config.get("sourcerer_repo", "external/sourcerer")
SOURCERER_COMMIT = "f14f84030c96ef080e011fb65e83bc9c04a54b8c"
PEPSDI_REPO = config.get("pepsdi_repo", "external/PEPSDI")
PEPSDI_COMMIT = "2255f1543ee601aa71f6bb46bc40f85e25e08537"


def external_file(w):
    tool = EXTERNAL[w.method]
    return RES + f"/external/{tool}/{w.example}/{w.method}_seed{w.seed}.{EXT_SUFFIX[tool]}"


rule arruda_repo:
    output:
        directory(ARRUDA_REPO),
    shell:
        "git clone -q https://github.com/arrjon/Amortized-NLME-Models {output} && "
        "git -C {output} checkout -q " + ARRUDA_COMMIT


rule sourcerer_repo:
    output:
        directory(SOURCERER_REPO),
    shell:
        "git clone -q https://github.com/mackelab/sourcerer {output} && "
        "git -C {output} checkout -q " + SOURCERER_COMMIT


rule data_fine:
    input:
        code=CODE + ["workflow/scripts/make_data_fine.py"],
    output:
        RES + "/data_fine/{example}_seed{seed}.npz",
    params:
        cfg=CFG,
    conda:
        ENV
    shell:
        "PYTHONPATH=. python workflow/scripts/make_data_fine.py --example {wildcards.example} "
        "--seed {wildcards.seed} --config {params.cfg} --out {output}"


rule arruda:
    input:
        repo=ARRUDA_REPO,
        code="workflow/scripts/fit_arruda.py",
        real=lambda w: C["examples"][w.example].get("data_tracks", []),
        fine=lambda w: [] if "data_tracks" in C["examples"][w.example] or C["examples"][w.example].get("kind") != "transfection_ssa"
        else [RES + f"/data_fine/{w.example}_seed{w.seed}.npz"],
    output:
        RES + "/external/arruda/{example}/{method}_seed{seed}.npz",
    params:
        cfg=CFG,
        py=config.get("arruda_python", "python"),
        fine=lambda w, input: f"--fine {input.fine}" if input.fine else "",
    conda:
        "envs/arruda.yaml"
    shell:
        "{params.py} workflow/scripts/fit_arruda.py --example {wildcards.example} --method {wildcards.method} "
        "--seed {wildcards.seed} --config {params.cfg} --repo {input.repo} --out {output} {params.fine}"


rule sourcerer:
    input:
        repo=SOURCERER_REPO,
        data=RES + "/data/{example}_seed{seed}.npz",
        code=CODE + ["workflow/scripts/fit_sourcerer.py"],
    output:
        RES + "/external/sourcerer/{example}/{method}_seed{seed}.npz",
    params:
        cfg=CFG,
    conda:
        "envs/sourcerer.yaml"
    shell:
        "PYTHONPATH=. python workflow/scripts/fit_sourcerer.py --example {wildcards.example} --method {wildcards.method} "
        "--seed {wildcards.seed} --config {params.cfg} --data {input.data} --repo {input.repo} --out {output}"


rule neb:
    input:
        repo=SOURCERER_REPO,
        data=RES + "/data/{example}_seed{seed}.npz",
        code=CODE + ["workflow/scripts/fit_neb.py"],
    output:
        RES + "/external/neb/{example}/{method}_seed{seed}.npz",
    params:
        cfg=CFG,
    conda:
        "envs/sourcerer.yaml"
    shell:
        "PYTHONPATH=. python workflow/scripts/fit_neb.py --example {wildcards.example} --method {wildcards.method} "
        "--seed {wildcards.seed} --config {params.cfg} --data {input.data} --repo {input.repo} --out {output}"


rule npmle:
    input:
        data=RES + "/data/{example}_seed{seed}.npz",
        code=CODE + ["cmc/npmle.py", "workflow/scripts/fit_npmle.py"],
    output:
        RES + "/external/npmle/{example}/{method}_seed{seed}.npz",
    params:
        cfg=CFG,
    shell:
        "PYTHONPATH=. python workflow/scripts/fit_npmle.py --example {wildcards.example} --method {wildcards.method} "
        "--seed {wildcards.seed} --config {params.cfg} --data {input.data} --out {output}"


PMCORE_DIR = "workflow/scripts/pmcore_tf"
PMCORE_BIN = "external/pmcore_tf/release/pmcore_tf"


rule pmcore_build:
    input:
        PMCORE_DIR + "/Cargo.toml",
        PMCORE_DIR + "/src/main.rs",
    output:
        PMCORE_BIN,
    params:
        cargo=config.get("pmcore_cargo", "cargo"),
    conda:
        "envs/pmcore.yaml"
    shell:
        # use the environment's own rustc (the runners' rustup shims would otherwise be picked up from PATH)
        'B="$(dirname $(command -v {params.cargo}))"; PATH="$B:$PATH" RUSTC="$B/rustc" '
        "{params.cargo} build --release --manifest-path " + PMCORE_DIR + "/Cargo.toml --target-dir external/pmcore_tf"


rule pmetrics:
    input:
        binary=PMCORE_BIN,
        data=RES + "/data/{example}_seed{seed}.npz",
        code=CODE + ["workflow/scripts/fit_pmetrics.py"],
    output:
        RES + "/external/pmetrics/{example}/{method}_seed{seed}.npz",
    params:
        cfg=CFG,
    threads: 2
    conda:
        ENV
    shell:
        "PYTHONPATH=. python workflow/scripts/fit_pmetrics.py --example {wildcards.example} --method {wildcards.method} "
        "--seed {wildcards.seed} --config {params.cfg} --data {input.data} --binary {input.binary} "
        "--threads {threads} --out {output}"


rule mlnpe:
    input:
        data=RES + "/data/{example}_seed{seed}.npz",
        code=CODE + ["workflow/scripts/fit_mlnpe.py"],
    output:
        RES + "/external/mlnpe/{example}/{method}_seed{seed}.npz",
    params:
        cfg=CFG,
    conda:
        "envs/mlnpe.yaml"
    shell:
        "PYTHONPATH=. python workflow/scripts/fit_mlnpe.py --example {wildcards.example} --method {wildcards.method} "
        "--seed {wildcards.seed} --config {params.cfg} --data {input.data} --out {output}"


rule pepsdi_repo:
    output:
        directory(PEPSDI_REPO),
    shell:
        "git clone -q https://github.com/cvijoviclab/PEPSDI {output} && "
        "git -C {output} checkout -q " + PEPSDI_COMMIT


rule pepsdi:
    input:
        repo=PEPSDI_REPO,
        data=RES + "/data/{example}_seed{seed}.npz",
        code=CODE + ["workflow/scripts/fit_pepsdi.jl", "workflow/scripts/pepsdi_io.py", "workflow/envs/pepsdi/Project.toml"],
    output:
        RES + "/external/pepsdi/{example}/{method}_seed{seed}.npz",
    params:
        cfg=CFG,
        julia=config.get("julia", "julia"),
        work=lambda w: RES + f"/external/pepsdi/{w.example}/{w.method}_seed{w.seed}_work",
    threads: 2
    shell:
        "PYTHONPATH=. python workflow/scripts/pepsdi_io.py prep --example {wildcards.example} --method {wildcards.method} "
        "--seed {wildcards.seed} --config {params.cfg} --data {input.data} --work {params.work} && "
        "JULIA_NUM_THREADS={threads} {params.julia} --project=$PWD/workflow/envs/pepsdi workflow/scripts/fit_pepsdi.jl "
        "--repo {input.repo} --work {params.work} && "
        "PYTHONPATH=. python workflow/scripts/pepsdi_io.py collect --example {wildcards.example} --method {wildcards.method} "
        "--seed {wildcards.seed} --config {params.cfg} --work {params.work} --out {output}"


rule nlme_csv:
    input:
        data=RES + "/data/{example}_seed{seed}.npz",
        code=CODE + ["workflow/scripts/nlme_csv.py"],
    output:
        RES + "/nlme/{example}_seed{seed}.csv",
    params:
        cfg=CFG,
    conda:
        ENV
    shell:
        "PYTHONPATH=. python workflow/scripts/nlme_csv.py --example {wildcards.example} --config {params.cfg} "
        "--data {input.data} --out {output}"


rule nlmixr2:
    input:
        csv=RES + "/nlme/{example}_seed{seed}.csv",
        code="workflow/scripts/fit_nlmixr2.R",
    output:
        RES + "/external/nlmixr2/{example}/{method}_seed{seed}.json",
    params:
        est=lambda w: C["methods"][w.method]["est"],
        rscript=config.get("nlmixr_rscript", "Rscript"),
    conda:
        "envs/nlmixr2.yaml"
    shell:
        # rxode2 compiles the model with the environment's compiler, so its bin directory goes on PATH
        'PATH="$(dirname $(command -v {params.rscript})):$PATH" '
        "{params.rscript} workflow/scripts/fit_nlmixr2.R {input.csv} {params.est} {wildcards.seed} {output}"


rule fit:
    input:
        data=RES + "/data/{example}_seed{seed}.npz",
        code=CODE + ["workflow/scripts/fit.py"],
        external=lambda w: [external_file(w)] if w.method in EXTERNAL else [],
    output:
        json=RES + "/fits/{example}/{method}_seed{seed}.json",
        npz=RES + "/fits/{example}/{method}_seed{seed}.npz",
    params:
        cfg=CFG,
        ext=lambda w, input: f"--external {input.external}" if input.external else "",
    conda:
        ENV
    shell:
        "PYTHONPATH=. python workflow/scripts/fit.py --example {wildcards.example} "
        "--method {wildcards.method} --seed {wildcards.seed} --config {params.cfg} "
        "--data {input.data} --out-json {output.json} --out-npz {output.npz} {params.ext}"


rule summarise:
    input:
        fits=FITS,
        data=expand(RES + "/data/{example}_seed{seed}.npz", example=EXAMPLES, seed=SEEDS),
        code=["workflow/scripts/summarise.py", "workflow/scripts/method_labels.py"],
    output:
        RES + "/summary/table.md",
        RES + "/summary/table.tex",
        RES + "/summary/scalar.pdf",
        RES + "/summary/recovery.pdf",
        RES + "/summary/params.pdf",
        RES + "/summary/params.png",
        RES + "/summary/combos_growth.pdf",
        RES + "/summary/combos_growth.png",
        RES + "/summary/combos_growth.tex",
        RES + "/summary/exact.pdf",
        RES + "/summary/exact.png",
        RES + "/summary/tracking.pdf",
        RES + "/summary/tracking.png",
        RES + "/summary/tracking.tex",
        RES + "/summary/bayes.pdf",
        RES + "/summary/bayes.png",
        RES + "/summary/bayes.tex",
        RES + "/summary/robustness.pdf",
        RES + "/summary/robustness.png",
        RES + "/summary/robustness.tex",
        RES + "/summary/ssa.pdf",
        RES + "/summary/ssa.png",
        RES + "/summary/ssa.tex",
        RES + "/summary/fish.pdf",
        RES + "/summary/fish.png",
        RES + "/summary/fish.tex",
        RES + "/summary/transfection.pdf",
        RES + "/summary/transfection.png",
        RES + "/summary/transfection.tex",
        expand(RES + "/summary/marginals_{example}.pdf", example=["growth", "gene", "linear"]),
    params:
        cfg=CFG,
        res=RES,
    conda:
        ENV
    shell:
        "PYTHONPATH=. python workflow/scripts/summarise.py --fits {params.res}/fits "
        "--data {params.res}/data --config {params.cfg} --out {params.res}/summary"


# posterior predictive checks: each method's fitted population simulated with noise, against the data.
# Fits and data are read from RES directly (params, not inputs), so this never reruns a fit.
PPC_SEED = config.get("ppc_seed", 1)
PPC_EXAMPLES = [e for e in EXAMPLES if C["examples"][e].get("methods")]


rule ppc:
    input:
        code=CODE + ["workflow/scripts/ppc.py"],
    output:
        RES + "/ppc/{example}_seed{seed}.npz",
    params:
        cfg=CFG,
        data=lambda w: RES + f"/data/{w.example}_seed{w.seed}.npz",
        fits=lambda w: RES + f"/fits/{w.example}",
    conda:
        ENV
    shell:
        "PYTHONPATH=. python workflow/scripts/ppc.py --example {wildcards.example} --seed {wildcards.seed} "
        "--config {params.cfg} --data {params.data} --fits {params.fits} --out {output}"


rule ppc_plots:
    input:
        ppc=expand(RES + "/ppc/{example}_seed{seed}.npz", example=PPC_EXAMPLES, seed=[PPC_SEED]),
        code=["workflow/scripts/plot_ppc.py", "workflow/scripts/method_labels.py"],
    output:
        directory(RES + "/summary/ppc"),
    params:
        cfg=CFG,
    conda:
        ENV
    shell:
        "PYTHONPATH=.:workflow/scripts python workflow/scripts/plot_ppc.py --ppc {RES}/ppc --config {params.cfg} "
        "--out {output}"
