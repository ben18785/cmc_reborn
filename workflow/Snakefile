"""Experiments for iterated, block-wise CMC.

    snakemake --use-conda --cores 4                     # everything (slow; normally on Actions)
    snakemake --use-conda --cores 1 summarise           # tables and figures from existing fits
    snakemake --cores 2 --configfile config/smoke.yaml \
        --config config_file=config/smoke.yaml results=results_smoke   # quick end-to-end check

Fits run on GitHub Actions (.github/workflows/experiments.yml): one job per
(example, method, seed), each running this Snakefile for its target; a final
job merges the fits and runs `summarise`. Every number is in config/config.yaml.
"""

configfile: "config/config.yaml"

import yaml

ENV = "envs/cmc.yaml"
CFG = config.get("config_file", "config/config.yaml")
RES = config.get("results", "results")
# read the experiment from CFG itself: --configfile merges nested keys into config.yaml,
# which would leak the main examples into a smoke run
C = yaml.safe_load(open(CFG))
EXAMPLES = list(C["examples"])
METHODS = list(C["methods"])
SEEDS = C["seeds"]
# an example may restrict its methods with `methods: [...]`
FITS = [RES + f"/fits/{e}/{m}_seed{s}.json" for e in EXAMPLES
        for m in C["examples"][e].get("methods", METHODS) for s in SEEDS]
CODE = ["cmc/models.py", "cmc/infer.py", "cmc/ratio.py", "cmc/metrics.py", "cmc/bayes.py", "cmc/ssa.py"]


rule all:
    input:
        RES + "/summary/table.md",


rule data:
    input:
        code=CODE + ["workflow/scripts/make_data.py"],
        real=lambda w: C["examples"][w.example].get("data_csv", C["examples"][w.example].get("data_tracks", [])),
    output:
        RES + "/data/{example}_seed{seed}.npz",
    params:
        cfg=CFG,
    conda:
        ENV
    shell:
        "PYTHONPATH=. python workflow/scripts/make_data.py --example {wildcards.example} "
        "--seed {wildcards.seed} --config {params.cfg} --out {output}"


# external methods run in their own environment and write population draws that `fit` scores
EXTERNAL = {m for m in C["methods"] if C["methods"][m]["kind"] == "external"}
ARRUDA_REPO = config.get("arruda_repo", "external/Amortized-NLME-Models")
ARRUDA_COMMIT = "592c8912300c68ab241160eb3e739a2651209a03"


rule arruda_repo:
    output:
        directory(ARRUDA_REPO),
    shell:
        "git clone -q https://github.com/arrjon/Amortized-NLME-Models {output} && "
        "git -C {output} checkout -q " + ARRUDA_COMMIT


rule data_fine:
    input:
        code=CODE + ["workflow/scripts/make_data_fine.py"],
    output:
        RES + "/data_fine/{example}_seed{seed}.npz",
    params:
        cfg=CFG,
    conda:
        ENV
    shell:
        "PYTHONPATH=. python workflow/scripts/make_data_fine.py --example {wildcards.example} "
        "--seed {wildcards.seed} --config {params.cfg} --out {output}"


rule arruda:
    input:
        repo=ARRUDA_REPO,
        code="workflow/scripts/fit_arruda.py",
        real=lambda w: C["examples"][w.example].get("data_tracks", []),
        fine=lambda w: [] if "data_tracks" in C["examples"][w.example] or C["examples"][w.example].get("kind") != "transfection_ssa"
        else [RES + f"/data_fine/{w.example}_seed{w.seed}.npz"],
    output:
        RES + "/external/{example}/{method}_seed{seed}.npz",
    params:
        cfg=CFG,
        py=config.get("arruda_python", "python"),
        fine=lambda w, input: f"--fine {input.fine}" if input.fine else "",
    conda:
        "envs/arruda.yaml"
    shell:
        "{params.py} workflow/scripts/fit_arruda.py --example {wildcards.example} --method {wildcards.method} "
        "--seed {wildcards.seed} --config {params.cfg} --repo {input.repo} --out {output} {params.fine}"


rule fit:
    input:
        data=RES + "/data/{example}_seed{seed}.npz",
        code=CODE + ["workflow/scripts/fit.py"],
        external=lambda w: [RES + f"/external/{w.example}/{w.method}_seed{w.seed}.npz"] if w.method in EXTERNAL else [],
    output:
        json=RES + "/fits/{example}/{method}_seed{seed}.json",
        npz=RES + "/fits/{example}/{method}_seed{seed}.npz",
    params:
        cfg=CFG,
        ext=lambda w, input: f"--external {input.external}" if input.external else "",
    conda:
        ENV
    shell:
        "PYTHONPATH=. python workflow/scripts/fit.py --example {wildcards.example} "
        "--method {wildcards.method} --seed {wildcards.seed} --config {params.cfg} "
        "--data {input.data} --out-json {output.json} --out-npz {output.npz} {params.ext}"


rule summarise:
    input:
        fits=FITS,
        data=expand(RES + "/data/{example}_seed{seed}.npz", example=EXAMPLES, seed=SEEDS),
        code="workflow/scripts/summarise.py",
    output:
        RES + "/summary/table.md",
        RES + "/summary/table.tex",
        RES + "/summary/scalar.pdf",
        RES + "/summary/recovery.pdf",
        RES + "/summary/params.pdf",
        RES + "/summary/params.png",
        RES + "/summary/combos_growth.pdf",
        RES + "/summary/combos_growth.png",
        RES + "/summary/combos_growth.tex",
        RES + "/summary/exact.pdf",
        RES + "/summary/exact.png",
        RES + "/summary/tracking.pdf",
        RES + "/summary/tracking.png",
        RES + "/summary/tracking.tex",
        RES + "/summary/bayes.pdf",
        RES + "/summary/bayes.png",
        RES + "/summary/bayes.tex",
        RES + "/summary/robustness.pdf",
        RES + "/summary/robustness.png",
        RES + "/summary/robustness.tex",
        RES + "/summary/ssa.pdf",
        RES + "/summary/ssa.png",
        RES + "/summary/ssa.tex",
        RES + "/summary/fish.pdf",
        RES + "/summary/fish.png",
        RES + "/summary/fish.tex",
        RES + "/summary/transfection.pdf",
        RES + "/summary/transfection.png",
        RES + "/summary/transfection.tex",
        expand(RES + "/summary/marginals_{example}.pdf", example=["growth", "gene", "linear"]),
    params:
        cfg=CFG,
        res=RES,
    conda:
        ENV
    shell:
        "PYTHONPATH=. python workflow/scripts/summarise.py --fits {params.res}/fits "
        "--data {params.res}/data --config {params.cfg} --out {params.res}/summary"
